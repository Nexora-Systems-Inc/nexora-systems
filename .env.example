# Public site URL — single override for the platform SEO source of truth
# (platform/seo/site.config.mjs). Must match the Vercel primary domain.
VITE_SITE_URL=https://www.nexorasystems.ca

# Analytics — leave empty until launch
VITE_GA_ID=
VITE_CLARITY_ID=
VITE_META_PIXEL_ID=

# Contact form (server-only — never prefix with VITE_)
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives website contact submissions
CONTACT_TO_EMAIL=info@nexorasystems.ca
# Verified Resend from address, e.g. "Nexora Systems <noreply@nexorasystems.ca>"
RESEND_FROM_EMAIL=
