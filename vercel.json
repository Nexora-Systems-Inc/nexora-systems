{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "nexorasystems.ca" }],
      "destination": "https://www.nexorasystems.ca/$1",
      "permanent": true
    },
    {
      "source": "/services/ai-construction",
      "destination": "/services/custom-solutions",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
